# Copy this file to .env.local and fill in the values.

# ─── Client (compiled into the browser bundle — never put a secret here) ───
# Find these at: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Which account sees the admin-only UI (View feedback / View users / seed).
# This is cosmetic gating only. The SERVER checks ADMIN_EMAIL below; anything
# VITE_-prefixed is public, so it can never be a security boundary.
VITE_ADMIN_EMAIL=

# ─── Server only (Vercel project env vars — NOT VITE_-prefixed) ────────────
# Same project as VITE_SUPABASE_URL. The service role key bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The deploy owner. The real admin check, and the one account whose Claude
# calls may fall back to ANTHROPIC_API_KEY below.
ADMIN_EMAIL=

# Needed for the linked cahier: api/cahier-sync.js and the daily cron parse
# every student's new classes with this key (the deploy owner pays for that).
# Otherwise it is used only for requests from ADMIN_EMAIL: every other user
# brings their own key from the app's "Connect Claude account" dialog, kept in
# their browser and sent per request — never stored here or in the database.
# Unset, the linked cahier can't parse anything and the admin must bring their
# own key like everyone else.
ANTHROPIC_API_KEY=

# The daily cahier check (api/cahier-daily.js, a Vercel cron). Vercel sends it
# as a bearer token with every cron request; without it the route refuses
# every caller, the cron included. Any long random string.
CRON_SECRET=

# Azure Speech (AZURE_SPEECH_KEY / AZURE_SPEECH_REGION) is no longer used.
# api/tts.js and api/pronounce.js were unauthenticated proxies to the deploy
# owner's Azure subscription and have been removed; speech now uses the
# browser's own speechSynthesis, which costs nothing.
